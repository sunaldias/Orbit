# =============================================================================
# ORBIT Website — Environment Variables Template
# Copy to .env.local for local development and configure in Vercel for production
# =============================================================================

# --- Public Site Configuration ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_AGENCY_EMAIL="bookings@orbitagency.example"
NEXT_PUBLIC_AGENCY_PHONE="+1 (555) 014-8920"
NEXT_PUBLIC_AGENCY_LOCATION="Los Angeles · London · Worldwide"

# --- Cloudinary Media CDN ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# --- Cloudflare Turnstile (Anti-Bot) ---
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Supabase PostgreSQL ---
# Public anon key is ONLY used for read-only published portfolio/services (RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEVER prefix with NEXT_PUBLIC_ — used strictly inside server-only API routes
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend Transactional Email ---
RESEND_API_KEY=""
# Verified sender address on your Resend domain (e.g., "ORBIT Studio <bookings@yourdomain.com>")
RESEND_FROM_EMAIL="ORBIT Studio <onboarding@resend.dev>"
# Destination inbox where project inquiries are delivered
INQUIRY_RECIPIENT_EMAIL="bookings@orbitagency.example"
# Set to "true" to also send an automated confirmation receipt to the client
SEND_CLIENT_CONFIRMATION="true"

# --- Upstash Redis (Distributed Rate Limiting) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Security Hashing Salt ---
# Generate a random 32+ character string (e.g., `openssl rand -hex 32`)
IP_HASH_SALT="replace-with-a-random-64-char-hex-secret-in-production"

# --- Optional On-Demand Portfolio Cache Revalidation ---
# Secret header (x-orbit-revalidate-secret) used by Supabase Webhooks when new projects are published
PORTFOLIO_REVALIDATE_SECRET="replace-with-a-random-32-char-secret"
